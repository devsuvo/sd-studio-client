# MongoDB used by BetterAuth (same cluster/database as the API server)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
DB_NAME=studiospace

# BetterAuth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Express API base URL (Next.js proxies /backend/* here, so the browser never calls it directly)
API_URL=http://localhost:5000

# Google sign-in (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
